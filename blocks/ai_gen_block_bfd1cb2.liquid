{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-info-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
  }

  .ai-product-info-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 30% 30% 40%;
    gap: {{ settings.spacing_grid_horizontal }}px;
  }

  .ai-product-info-box-{{ ai_gen_id }} {
    background-color: {{ block.settings.box_background }};
    border: {{ block.settings.box_border_thickness }}px solid {{ block.settings.box_border_color }};
    border-radius: {{ settings.media_radius }}px;
    padding: {{ block.settings.box_padding }}px;
  }

  .ai-product-info-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    font-size: calc({{ block.settings.title_size }}px * {{ settings.heading_scale }} / 100);
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.3;
    text-align: left;
  }

  .ai-product-info-specs-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ai-product-info-specs-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.label_width }}% 1fr;
    gap: {{ block.settings.column_spacing }}px;
    padding: {{ block.settings.row_padding }}px 0;
    border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-product-info-specs-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-product-info-label-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: calc({{ block.settings.label_size }}px * {{ settings.body_scale }} / 100);
    color: {{ block.settings.label_color }};
    font-weight: 600;
    text-align: left;
  }

  .ai-product-info-value-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: calc({{ block.settings.value_size }}px * {{ settings.body_scale }} / 100);
    color: {{ block.settings.text_color }};
    text-align: left;
  }

  .ai-product-info-checklist-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.checklist_spacing }}px;
  }

  .ai-product-info-checklist-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-product-info-checklist-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    margin-top: 2px;
  }

  .ai-product-info-checklist-text-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: calc({{ block.settings.checklist_text_size }}px * {{ settings.body_scale }} / 100);
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    text-align: left;
  }

  .ai-product-info-cta-box-{{ ai_gen_id }} {
    border-radius: {{ settings.media_radius }}px;
    padding: {{ block.settings.cta_box_padding }}px;
    {% if block.settings.cta_image %}
      background-image: url('{{ block.settings.cta_image | image_url: width: 1000 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      position: relative;
    {% else %}
      background-color: {{ block.settings.cta_box_background }};
    {% endif %}
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .ai-product-info-cta-box-{{ ai_gen_id }}::before {
    {% if block.settings.cta_image %}
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(255, 255, 255, {{ block.settings.overlay_opacity }});
      border-radius: {{ settings.media_radius }}px;
      pointer-events: none;
    {% endif %}
  }

  .ai-product-info-cta-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.cta_spacing }}px;
    align-items: flex-start;
    position: relative;
    z-index: 1;
    margin-top: 18px;
    margin-right: 18px;
  }

  .ai-product-info-cta-icon-{{ ai_gen_id }} {
    width: {{ block.settings.cta_icon_size }}px;
    height: {{ block.settings.cta_icon_size }}px;
    flex-shrink: 0;
  }

  .ai-product-info-cta-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-product-info-cta-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    font-size: calc({{ block.settings.cta_title_size }}px * {{ settings.heading_scale }} / 100);
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.3;
    text-align: left;
  }

  .ai-product-info-cta-text-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: calc({{ block.settings.cta_text_size }}px * {{ settings.body_scale }} / 100);
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    text-align: left;
  }

  .ai-product-info-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ settings.buttons_radius }}px;
    border: {{ settings.buttons_border_thickness }}px solid {{ block.settings.button_background }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-size: calc({{ block.settings.button_text_size }}px * {{ settings.body_scale }} / 100);
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-product-info-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    border-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-product-info-empty-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    color: #999;
    font-size: 14px;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-product-info-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-product-info-specs-row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .ai-product-info-box-{{ ai_gen_id }}:nth-child(1) {
      order: 1;
    }

    .ai-product-info-box-{{ ai_gen_id }}:nth-child(2) {
      order: 2;
    }

    .ai-product-info-cta-box-{{ ai_gen_id }} {
      order: 3;
    }

    .ai-product-info-cta-section-{{ ai_gen_id }} {
      margin-top: 0;
      margin-right: 0;
    }
  }
{% endstyle %}

<product-info-block-{{ ai_gen_id }}
  class="ai-product-info-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
