{% comment %}Only server-known cart lines are used; requested quantities live separately from inventory.{% endcomment %}
{% capture request_json %}
  {
    "note": {{ cart.note | json }},
    "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
    "items": [
      {% for item in cart.items %}
        {
          "key": {{ item.key | json }},
          "title": {{ item.product.title | json }},
          "variant": {{ item.variant.title | json }},
          "sku": {{ item.sku | json }},
          "properties": {% capture properties %}{% for property in item.properties %}{% assign first_char = property.first | slice: 0 %}{% if first_char != '_' and property.last != blank %}{{ property.first }}: {{ property.last }}; {% endif %}{% endfor %}{% endcapture %}{{ properties | strip | json }},
          "sellingPlan": {{ item.selling_plan_allocation.selling_plan.name | json }},
          "quantity": {{ item.quantity | json }},
          "price": {{ item.original_price | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
{% endcapture %}
<div hidden data-cart-request-data="{{ request_json | escape }}"></div>
