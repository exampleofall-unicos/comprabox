{% render 'contact-quote-content', section: section %}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Iconos de botones"
    },
    {
      "type": "image_picker",
      "id": "section_button_icon_image",
      "label": "Imagen para los botones",
      "info": "Opcional. Sin imagen se usa la configuración global del tema. Se recomienda PNG transparente."
    },
{"type": "select", "id": "section_button_icon_image_position", "label": "Posición del icono", "default": "inherit", "options": [{"value": "inherit", "label": "Heredar configuración"}, {"value": "left", "label": "Izquierda del texto"}, {"value": "right", "label": "Derecha del texto"}]},
{"type": "color", "id": "section_button_icon_image_text_color", "label": "Color del texto del botón", "info": "Opcional. Vacío conserva el esquema de colores o la configuración heredada."},
    {
      "type": "range",
      "id": "section_button_icon_size",
      "label": "Tamaño de iconos",
      "info": "Se aplica a las imágenes elegidas en esta sección o sus bloques.",
      "min": 12,
      "max": 40,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "SOLICITÁ TU COTIZACIÓN"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Cuanta más información nos brindes, más precisa será tu cotización.</p>"
    },
    {
      "type": "textarea",
      "id": "provinces",
      "label": "Provincias",
      "info": "Una opción por línea. No dejar vacío.",
      "default": "Ciudad Autónoma de Buenos Aires\nBuenos Aires\nCatamarca\nChaco\nChubut\nCórdoba\nCorrientes\nEntre Ríos\nFormosa\nJujuy\nLa Pampa\nLa Rioja\nMendoza\nMisiones\nNeuquén\nRío Negro\nSalta\nSan Juan\nSan Luis\nSanta Cruz\nSanta Fe\nSantiago del Estero\nTierra del Fuego\nTucumán"
    },
    {
      "type": "textarea",
      "id": "products",
      "label": "Productos de interés",
      "info": "Una opción por línea. No dejar vacío.",
      "default": "Termos\nMates\nBotellas\nVasos\nTazas\nJarros\nShakers\nSets y combos\nOtro"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Texto del botón de envío",
      "default": "Enviar solicitud de cotización"
    },
    {
      "type": "image_picker",
      "id": "submit_icon",
      "label": "Imagen del botón de envío"
    },
{"type": "select", "id": "submit_icon_position", "label": "Posición del icono", "default": "inherit", "options": [{"value": "inherit", "label": "Heredar configuración"}, {"value": "left", "label": "Izquierda del texto"}, {"value": "right", "label": "Derecha del texto"}]},
{"type": "color", "id": "submit_icon_text_color", "label": "Color del texto del botón", "info": "Opcional. Vacío conserva el esquema de colores o la configuración heredada."},
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Nota al pie",
      "default": "Usaremos tus datos para responder tu consulta."
    },
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "label": "Mostrar panel de contacto",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_heading",
      "label": "Título de WhatsApp",
      "default": "Hablá directamente por WhatsApp"
    },
    {
      "type": "richtext",
      "id": "whatsapp_text",
      "label": "Texto de WhatsApp",
      "default": "<p>Conversá con nuestro equipo comercial.</p>"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "Enlace de WhatsApp",
      "info": "Usá https://wa.me/ seguido del número completo con código de país, sin espacios ni signos."
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "Texto del botón de WhatsApp",
      "default": "Iniciar conversación"
    },
    {
      "type": "image_picker",
      "id": "whatsapp_icon",
      "label": "Imagen del botón de WhatsApp"
    },
{"type": "select", "id": "whatsapp_icon_position", "label": "Posición del icono", "default": "inherit", "options": [{"value": "inherit", "label": "Heredar configuración"}, {"value": "left", "label": "Izquierda del texto"}, {"value": "right", "label": "Derecha del texto"}]},
{"type": "color", "id": "whatsapp_icon_text_color", "label": "Color del texto del botón", "info": "Opcional. Vacío conserva el esquema de colores o la configuración heredada."},
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Título de datos de contacto",
      "default": "Otros medios de contacto"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de iconos y texto superior",
      "default": "#f57800"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Fondo de las tarjetas",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "whatsapp_color",
      "label": "Fondo de WhatsApp",
      "default": "#fff1e5"
    },
    {
      "type": "range",
      "id": "contact_icon_size",
      "label": "Tamaño de iconos de contacto",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Iconos del formulario"
    },
    {
      "type": "image_picker",
      "id": "field_icon_name",
      "label": "Nombre y apellido",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_empresa",
      "label": "Empresa / Negocio",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_cuit",
      "label": "CUIT",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_provincia",
      "label": "Provincia",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_phone",
      "label": "WhatsApp del formulario",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_producto",
      "label": "Producto de interés",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_cantidad",
      "label": "Cantidad estimada",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_personalizacion",
      "label": "Personalización",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_email",
      "label": "Correo electrónico",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "image_picker",
      "id": "field_icon_body",
      "label": "Mensaje adicional",
      "info": "Opcional. Sin imagen se conserva el icono predeterminado."
    },
    {
      "type": "range",
      "id": "field_icon_size",
      "label": "Tamaño de iconos de campos",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "privacy_icon",
      "label": "Icono de nota al pie"
    },
    {
      "type": "image_picker",
      "id": "success_icon",
      "label": "Icono de envío exitoso"
    },
    {
      "type": "header",
      "content": "Imágenes del panel de WhatsApp"
    },
    {
      "type": "image_picker",
      "id": "whatsapp_badge",
      "label": "Icono de WhatsApp junto al título"
    },
    {
      "type": "image_picker",
      "id": "whatsapp_art",
      "label": "Imagen decorativa a la derecha",
      "info": "Opcional. Por ejemplo, una ilustración de WhatsApp con fondo transparente."
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name",
      "settings": {
        "heading": "Completá el formulario",
        "heading_size": "h2"
      },
      "blocks": [
        {
          "type": "contact_detail",
          "settings": {
            "icon": "phone",
            "title": "Teléfono"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "email",
            "title": "Email"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "pin",
            "title": "Dirección"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "clock",
            "title": "Horarios de atención"
          }
        }
      ]
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "contact_detail",
      "name": "Icono y contacto",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            {
              "value": "phone",
              "label": "Teléfono"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "pin",
              "label": "Dirección"
            },
            {
              "value": "clock",
              "label": "Horarios"
            },
            {
              "value": "whatsapp",
              "label": "WhatsApp"
            }
          ],
          "default": "phone"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icono personalizado"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Contacto"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Dato de contacto"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace opcional",
          "info": "Por ejemplo, tel:+541112345678, mailto:ventas@tudominio.com o un enlace al mapa."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Información adicional"
        },
        {
          "type": "checkbox",
          "id": "tint_icon",
          "label": "Aplicar color al icono PNG",
          "default": false,
          "info": "Usa el color de iconos de la sección. Requiere una imagen con fondo transparente."
        }
      ]
    }
  ]
}
{% endschema %}
