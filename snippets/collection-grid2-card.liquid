{%- liquid
  assign capacity_parts = capacity_metafield | default: section.settings.capacity_metafield | strip | split: '.'
  assign box_parts = section.settings.box_metafield | default: 'custom.unidades_por_caja' | strip | split: '.'
  assign capacity = product.metafields[capacity_parts.first][capacity_parts.last]
  assign box_units = product.metafields[box_parts.first][box_parts.last].value | default: product.metafields.custom.unidades_por_caja.value | plus: 0
  assign variant = product.selected_or_first_available_variant
  assign product_url = product.url | split: '?' | first | append: '?view=co&variant=' | append: variant.id
  assign secondary_image = product.images[1]
  assign image_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign image_loading = 'lazy'
  if eager
    assign image_loading = 'eager'
  endif
-%}
<article class="cg2-card">
  <a href="{{ product_url | escape }}" class="cg2-card-image{% if secondary_image and secondary_image != product.featured_image %} cg2-card-image--hover{% endif %}" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: widths: '180, 300, 450, 600, 900', sizes: image_sizes, loading: image_loading, alt: product.featured_image.alt }}
      {%- if secondary_image and secondary_image != product.featured_image -%}
        {{ secondary_image | image_url: width: 900 | image_tag: widths: '180, 300, 450, 600, 900', sizes: image_sizes, loading: 'lazy', class: 'cg2-secondary-image', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- unless product.available -%}<span class="cg2-sold-out">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
  </a>
  <div class="cg2-card-content">
    <h3 class="cg2-product-title"><a href="{{ product_url | escape }}">{{ product.title | escape }}</a></h3>
    {%- if variant.sku != blank -%}<p class="cg2-sku">SKU: {{ variant.sku | escape }}</p>{%- endif -%}
    {%- if capacity != blank -%}<p class="cg2-capacity">{{ capacity | metafield_text | escape }}</p>{%- endif -%}
    {%- if variant -%}
      <p class="cg2-quote-price" data-cg2-card-price>{{ variant.price | money_with_currency }}</p>
    {%- endif -%}
    {%- if section.settings.show_price -%}
      <p class="cg2-price">Precio de venta: {{ variant.price | money_with_currency }}</p>
    {%- endif -%}
    <div class="cg2-card-actions">
      <button type="button" class="cg2-card-button cg2-card-button--add" data-cg2-open aria-haspopup="dialog" aria-controls="Grid2Quantity-{{ section.id }}" disabled>Agregar al carrito</button>
      {%- if box_units >= 3 -%}
        <button type="button" class="cg2-card-button cg2-card-button--box" data-cg2-open aria-label="Caja de {{ box_units }} unidades" aria-haspopup="dialog" aria-controls="Grid2Quantity-{{ section.id }}" disabled>X {{ box_units }}</button>
      {%- endif -%}
    </div>
  </div>
  {% render 'product-request-data', product: product, variant: variant, box_metafield: section.settings.box_metafield, usd_metafield: section.settings.usd_metafield %}
</article>
