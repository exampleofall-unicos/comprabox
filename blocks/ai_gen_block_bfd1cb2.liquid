            <img
              src="{{ block.settings.cta_icon | image_url: width: 200 }}"
              alt="{{ block.settings.cta_icon.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.cta_icon_size }}"
              height="{{ block.settings.cta_icon_size }}"
            >
          </div>
        {% endif %}

        {% if block.settings.cta_title != blank %}
          <h4 class="ai-product-info-cta-title-{{ ai_gen_id }}">{{ block.settings.cta_title }}</h4>
        {% endif %}

        {% if block.settings.cta_text != blank %}
          <div class="ai-product-info-cta-text-{{ ai_gen_id }}">{{ block.settings.cta_text }}</div>
        {% endif %}

        {% if block.settings.cta_button_text != blank %}
          <a
            href="{{ block.settings.cta_button_url }}"
            class="ai-product-info-cta-button-{{ ai_gen_id }}"
          >
            {{ block.settings.cta_button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</product-info-block-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductInfoBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('product-info-block-{{ ai_gen_id }}', ProductInfoBlock{{ ai_gen_id }});
  })();
</script>

