{%- render 'section-button-icons', section: section -%}
{{ 'section-newsletter-benefits.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign intro = section.blocks | where: 'type', 'heading'
  assign paragraphs = section.blocks | where: 'type', 'paragraph'
  assign eyebrows = section.blocks | where: 'type', 'eyebrow'
  assign intro_count = intro.size | plus: paragraphs.size | plus: eyebrows.size
  assign upper_image = section.settings.upper_image | default: section.settings.upper_image_mobile
  assign upper_mobile = section.settings.upper_image_mobile | default: upper_image
  assign lower_image = section.settings.image | default: section.settings.image_mobile
  assign lower_mobile = section.settings.image_mobile | default: lower_image
-%}
{%- style -%}
  {%- if section.settings.custom_font -%}{{ section.settings.font | font_face: font_display: 'swap' }}{%- endif -%}
  #Newsletter-{{ section.id }} {
    --nl-upper-bg: {{ section.settings.upper_background }};
    --nl-upper-text: {{ section.settings.upper_text }};
    --nl-muted: {{ section.settings.muted_text }};
    --nl-lower-bg: {{ section.settings.lower_background }};
    --nl-lower-text: {{ section.settings.lower_text }};
    --nl-accent: {{ section.settings.accent_color }};
    --nl-divider: {{ section.settings.divider_color }};
    --nl-input-bg: {{ section.settings.input_background }};
    --nl-input-text: {{ section.settings.input_text }};
    --nl-upper-overlay: {{ section.settings.upper_overlay | divided_by: 100.0 }};
    --nl-lower-overlay: {{ section.settings.lower_overlay | divided_by: 100.0 }};
    --nl-icon: {{ section.settings.icon_size }}px;
    --nl-mail-icon: {{ section.settings.mail_icon_size }}px;
    --nl-width: {{ section.settings.content_width }}px;
    --nl-top: {{ section.settings.padding_top }}px;
    --nl-bottom: {{ section.settings.padding_bottom }}px;
    --nl-bar-padding: {{ section.settings.bar_padding }}px;
    --nl-count: {{ benefits.size | at_least: 1 }};
    --nl-upper-position: {{ upper_image.presentation.focal_point | default: '50% 50%' }};
    --nl-upper-mobile-position: {{ upper_mobile.presentation.focal_point | default: '50% 50%' }};
    --nl-lower-position: {{ lower_image.presentation.focal_point | default: '50% 50%' }};
    --nl-lower-mobile-position: {{ lower_mobile.presentation.focal_point | default: '50% 50%' }};
    {%- if section.settings.custom_font %}
      --nl-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
      --nl-weight: {{ section.settings.font.weight }};
      --nl-style: {{ section.settings.font.style }};
    {%- endif %}
  }
  {%- for block in section.blocks -%}
    {%- if block.settings.custom_size -%}
      #Newsletter-{{ section.id }} #NewsletterText-{{ block.id }} { font-size: {{ block.settings.size_mobile }}px; }
      @media screen and (min-width: 750px) {
        #Newsletter-{{ section.id }} #NewsletterText-{{ block.id }} { font-size: {{ block.settings.size_desktop }}px; }
      }
    {%- endif -%}
    {%- if block.type == 'benefit' or block.type == 'email_form' -%}
      #Newsletter-{{ section.id }} #NewsletterDescription-{{ block.id }} { font-size: {{ block.settings.description_size }}px; }
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}
<div id="Newsletter-{{ section.id }}" class="nl-section{% unless section.settings.full_width %} page-width{% endunless %}">
  {%- if intro_count > 0 or benefits.size > 0 -%}
    <div class="nl-upper">
      {% render 'newsletter-background', image: upper_image, image_mobile: upper_mobile %}
      <div class="nl-overlay"></div>
      <div class="nl-inner">
        {%- if intro_count > 0 -%}
          <div class="nl-intro">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'eyebrow' -%}
                  <p id="NewsletterText-{{ block.id }}" class="nl-eyebrow caption-with-letter-spacing" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                {%- when 'heading' -%}
                  <h2 id="NewsletterText-{{ block.id }}" class="nl-heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
                {%- when 'paragraph' -%}
                  <div id="NewsletterText-{{ block.id }}" class="nl-paragraph rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if benefits.size > 0 -%}
          <ul class="nl-benefits" role="list">
            {%- for block in benefits -%}
              <li class="nl-benefit" {{ block.shopify_attributes }}>
                <span class="nl-icon{% if block.settings.image != blank and block.settings.tint_icon %} nl-icon--tinted{% endif %}" aria-hidden="true" {% if block.settings.image != blank and block.settings.tint_icon %}style="--nl-mask: url('{{ block.settings.image | image_url: width: 240 | escape }}');"{% endif %}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 240 | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', alt: '' }}
                  {%- else -%}{% render 'newsletter-benefit-icon', icon: block.settings.icon %}{%- endif -%}
                </span>
                <div class="nl-benefit-copy">
                  <h3 id="NewsletterText-{{ block.id }}" class="nl-benefit-title">{{ block.settings.title }}</h3>
                  <p id="NewsletterDescription-{{ block.id }}" class="nl-benefit-description">{{ block.settings.description }}</p>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'email_form' -%}
      <div class="nl-lower color-{{ section.settings.color_scheme }}" {{ block.shopify_attributes }}>
        {% render 'newsletter-background', image: lower_image, image_mobile: lower_mobile %}
        <div class="nl-overlay"></div>
        <div class="nl-inner nl-form-layout">
          <div class="nl-form-copy">
            {%- if block.settings.show_icon -%}<span class="nl-mail" aria-hidden="true">{% render 'newsletter-benefit-icon', icon: 'mail' %}</span>{%- endif -%}
            <div>
              {%- if block.settings.title != blank -%}<h2 id="NewsletterText-{{ block.id }}" class="nl-form-heading h2">{{ block.settings.title }}</h2>{%- endif -%}
              {%- if block.settings.description != blank -%}<div id="NewsletterDescription-{{ block.id }}" class="nl-description rte">{{ block.settings.description }}</div>{%- endif -%}
            </div>
          </div>
          {%- liquid
            assign form_id = 'NewsletterCustomer-' | append: section.id
            assign email_label = 'newsletter.label' | t
            assign email_label = block.settings.email_label | default: email_label
            assign button_label = 'newsletter.button_label' | t
            assign button_label = block.settings.button_label | default: button_label
          -%}
{% form 'customer', id: form_id, class: 'nl-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div>
                <div class="nl-fields">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="nl-input"
                    value="{{ form.email | escape }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    placeholder="{{ email_label | escape }}"
                    required
                  >
                  <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                    {{ email_label | escape }}
                  </label>
                  <button
                    type="submit"
                    {% render 'button-icon-attributes', image: block.settings.button_image %}
                    class="nl-submit button{% if block.settings.button_secondary %} button--secondary{% else %} button--primary{% endif %}"
                    name="commit"
                    id="Subscribe-{{ section.id }}"
                    aria-label="{{ button_label | escape }}"
                  >
                    {{ button_label | escape }}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                  </button>
                </div>
                {%- if form.errors -%}
                  <small role="alert" class="nl-message form__message" id="Newsletter-error--{{ section.id }}">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3 role="status"
                  class="nl-message form__message"
                  id="Newsletter-success--{{ section.id }}"
                  tabindex="-1"
                  autofocus
                >
                  <span class="svg-wrapper">
                    {{- 'icon-success.svg' | inline_asset_content -}}
                  </span>
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {% endform %}
        </div>
      </div>
    {%- elsif block.type == '@app' -%}
      <div class="nl-inner nl-app">{% render block %}</div>
    {%- endif -%}
  {%- endfor -%}
</div>
