{% comment %}Decorative image/SVG shared by quotation fields and sidebar blocks.{% endcomment %}
{% if image != blank %}
  {% if tint %}
    <span class="quote-icon-mask" style="--quote-icon-image: url('{{ image | image_url: width: 120 | escape }}');" aria-hidden="true"></span>
  {% else %}
    {{ image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
  {% endif %}
{% else %}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% case icon %}
{% when 'success' %}<circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/>
{% when 'person' %}<circle cx="12" cy="7" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3"/>
{% when 'business' %}<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V3h8v4M3 12h18M10 12v3h4v-3"/>
{% when 'pin' %}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>
{% when 'phone' %}<path d="m5 3 4 4-2 3a16 16 0 0 0 7 7l3-2 4 4-2 3C9 23 1 15 2 5Z"/>
{% when 'whatsapp' %}<path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3 20.5l1.3-4.8a8.5 8.5 0 1 1 16.2-4Z"/><path d="M8.1 7.1c-.5 0-1.1.9-1 1.8.2 3 3.9 6.6 6.9 6.9.9.1 1.9-.6 1.9-1.1l-2.3-1.3-.9 1c-1.5-.6-3.3-2.4-3.8-3.8l1-.9-1.1-2.6Z"/>
{% when 'email' %}<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7L22 6"/>
{% when 'box' %}<path d="m3 7 9-5 9 5v10l-9 5-9-5Zm0 0 9 5 9-5M12 12v10M7 4l9 5"/>
{% when 'quantity' %}<path d="M3 21V11h5v10m0 0V7h5v14m0 0V3h5v18M2 21h20"/>
{% when 'edit' %}<path d="m4 16 12-12 4 4L8 20l-5 1Zm10-10 4 4"/>
{% when 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/>
{% when 'send' %}<path d="m22 2-7 20-4-9-9-4ZM22 2 11 13"/>
{% when 'lock' %}<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
{% else %}<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>
{% endcase %}
</svg>

{% endif %}
