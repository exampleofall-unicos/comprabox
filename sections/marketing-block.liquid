{%- render 'section-button-icons', section: section -%}
{{ 'section-marketing-block.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign copy_count = section.blocks.size | minus: benefit_blocks.size
  assign desktop_image = section.settings.image | default: section.settings.image_mobile
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
-%}

{%- style -%}
  {%- if section.settings.custom_font -%}
    {{ section.settings.font | font_face: font_display: 'swap' }}
  {%- endif -%}
  #Marketing-{{ section.id }} {
    --mk-background: {{ section.settings.background }};
    --mk-text: {{ section.settings.text_color }};
    --mk-heading: {{ section.settings.heading_color }};
    --mk-accent: {{ section.settings.accent_color }};
    --mk-panel: {{ section.settings.panel_color | color_modify: 'alpha', section.settings.panel_opacity }};
    --mk-panel-text: {{ section.settings.panel_text_color }};
    --mk-overlay: {{ section.settings.overlay_color }};
    --mk-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --mk-width: {{ section.settings.content_width }}px;
    --mk-panel-width: {{ section.settings.panel_width }}px;
    --mk-gap: {{ section.settings.column_gap }}px;
    --mk-radius: {{ section.settings.panel_radius }}px;
    --mk-icon: {{ section.settings.icon_size }}px;
    --mk-padding: {{ section.settings.padding_mobile }}px;
    --mk-height: {{ section.settings.min_height_mobile }}px;
    --mk-desktop-position: {{ desktop_image.presentation.focal_point | default: '50% 50%' }};
    --mk-mobile-position: {{ mobile_image.presentation.focal_point | default: '50% 50%' }};
    {%- if section.settings.custom_font %}
      --mk-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
      --mk-font-style: {{ section.settings.font.style }};
      --mk-font-weight: {{ section.settings.font.weight }};
    {%- endif %}
  }
  {%- for block in section.blocks -%}
    #Marketing-{{ section.id }} #MarketingText-{{ block.id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
      {%- if block.settings.text_color != blank %}
        color: {{ block.settings.text_color }};
      {%- endif %}
    }
    @media screen and (min-width: 750px) {
      #Marketing-{{ section.id }} #MarketingText-{{ block.id }} {
        font-size: {{ block.settings.font_size_desktop }}px;
      }
    }
  {%- endfor -%}
  @media screen and (min-width: 990px) {
    #Marketing-{{ section.id }} {
      --mk-padding: {{ section.settings.padding_desktop }}px;
      --mk-height: {{ section.settings.min_height }}px;
    }
  }
{%- endstyle -%}

<div id="Marketing-{{ section.id }}" class="marketing-block color-{{ section.settings.color_scheme }}">
  {%- if desktop_image != blank -%}
    <picture class="marketing-block__media" aria-hidden="true">
      {%- if mobile_image != blank -%}
        <source media="(max-width: 989px)" sizes="100vw" srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w, {{ mobile_image | image_url: width: 1500 }} 1500w">
      {%- endif -%}
      {{ desktop_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: image_loading, fetchpriority: image_priority, alt: '' }}
    </picture>
  {%- endif -%}
  <div class="marketing-block__overlay"></div>
  <div class="marketing-block__layout{% if benefit_blocks.size == 0 or copy_count == 0 %} marketing-block__layout--text-only{% endif %}">
    {%- if copy_count > 0 -%}
      <div class="marketing-block__copy">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p id="MarketingText-{{ block.id }}" class="marketing-block__eyebrow caption-with-letter-spacing" {{ block.shopify_attributes }}>{{ block.settings.eyebrow | escape }}</p>
            {%- when 'heading' -%}
              <h2 id="MarketingText-{{ block.id }}" class="marketing-block__heading inline-richtext" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- when 'text' -%}
              <div id="MarketingText-{{ block.id }}" class="marketing-block__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'button' -%}
              <div class="marketing-block__button-wrapper" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label != blank -%}
                  <a id="MarketingText-{{ block.id }}" class="marketing-block__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %} {% render 'button-icon-attributes', image: block.settings.button_image %}>
                    {{ block.settings.button_label | escape }}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if benefit_blocks.size > 0 -%}
      <ul class="marketing-block__benefits" role="list">
        {%- for block in benefit_blocks -%}
          <li class="marketing-block__benefit" {{ block.shopify_attributes }}>
            <span class="marketing-block__icon{% if block.settings.image != blank and block.settings.tint_icon %} marketing-block__icon--tinted{% endif %}" aria-hidden="true"
              {% if block.settings.image != blank and block.settings.tint_icon %}style="--mk-mask: url('{{ block.settings.image | image_url: width: 240 | escape }}');"{% endif %}
            >
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 240 | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', alt: '' }}
              {%- else -%}
                {% render 'marketing-benefit-icon', icon: block.settings.icon %}
              {%- endif -%}
            </span>
            <div id="MarketingText-{{ block.id }}" class="marketing-block__benefit-text">{{ block.settings.text }}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

