<div {{ block.shopify_attributes }}>
  <form id="{{ product_form_id }}" class="product-form" data-product-request-form data-cart-url="{{ routes.cart_url }}">
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <div class="product-form__buttons">
      <button type="submit" name="add" value="save" data-product-request-button disabled
        class="product-form__submit button button--full-width button--secondary"
        {% render 'button-icon-attributes', image: block.settings.button_image, position: block.settings.button_image_position, text_color: block.settings.button_image_text_color %}>
        Agregar al carrito
      </button>
      <button type="submit" name="review" value="review" data-product-request-button disabled
        class="button button--full-width button--primary"
        {% render 'button-icon-attributes', image: block.settings.button_image, position: block.settings.button_image_position, text_color: block.settings.button_image_text_color %}>
        Revisar pedido
      </button>
    </div>
    <p data-product-request-status role="status" aria-live="polite"></p>
    <noscript>Activá JavaScript para guardar las unidades solicitadas y revisar tu pedido.</noscript>
  </form>
</div>
