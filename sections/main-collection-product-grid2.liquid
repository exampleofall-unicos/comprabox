{%- render 'section-button-icons', section: section -%}
{{ 'section-collection-grid2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quote-pricing.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quote-request-store.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'collection-grid2.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign form_id = 'CollectionGrid2Filters-' | append: section.id
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign availability_filter = collection.filters | where: 'param_name', 'filter.v.availability' | first
  assign category_filter = collection.filters | where: 'param_name', 'filter.p.t.category' | first
  assign category_param = section.settings.category_metafield | strip | prepend: 'filter.p.m.'
  assign capacity_param = section.settings.capacity_metafield | strip | prepend: 'filter.p.m.'
  if category_filter == blank and category_param != capacity_param
    assign category_filter = collection.filters | where: 'param_name', category_param | first
  endif
  assign capacity_filter = collection.filters | where: 'param_name', capacity_param | first
  assign price_filter = collection.filters | where: 'type', 'price_range' | first
  assign has_filters = false
  if availability_filter or category_filter or capacity_filter or price_filter
    assign has_filters = true
  endif
  assign show_sidebar = has_filters
  if request.design_mode
    assign show_sidebar = true
  endif
-%}
{%- style -%}
  #CollectionGrid2-{{ section.id }} {
    --cg2-columns: {{ section.settings.columns_desktop }};
    --cg2-mobile-columns: {{ section.settings.columns_mobile }};
    --cg2-padding: {{ section.settings.padding }}px;
    --cg2-heading: calc(var(--font-heading-scale) * {{ section.settings.heading_size | divided_by: 10.0 }}rem);
    --cg2-product-title: calc(var(--font-heading-scale) * {{ section.settings.product_title_size | divided_by: 10.0 }}rem);
    --cg2-accent: {{ section.settings.accent_color }};
    --cg2-image-bg: {{ section.settings.image_background }};
    --cg2-ratio: {{ section.settings.image_ratio }};
  }
{%- endstyle -%}
<collection-grid-quote id="CollectionGrid2-{{ section.id }}" class="cg2 color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="page-width cg2-layout{% if show_sidebar %} cg2-layout--with-filters{% endif %}">
      <aside class="cg2-sidebar" aria-labelledby="FilterTitle-{{ section.id }}"{% unless show_sidebar %} hidden{% endunless %}>
        <div class="cg2-filter-top">
          <h2 id="FilterTitle-{{ section.id }}">Filtros</h2>
          {%- if has_filters -%}<a href="{{ collection.url }}?sort_by={{ sort_by | url_encode }}">Limpiar filtros</a>{%- endif -%}
        </div>
        <form id="{{ form_id }}" method="get" action="{{ collection.url }}" data-cg2-filters>
          {%- if availability_filter -%}
            {% render 'collection-grid2-filter', filter: availability_filter, label: 'Disponibilidad', initially_open: true %}
          {%- endif -%}
          {%- if category_filter -%}
            {% render 'collection-grid2-filter', filter: category_filter, label: 'Categoría' %}
          {%- endif -%}
          {%- if capacity_filter -%}
            {% render 'collection-grid2-filter', filter: capacity_filter, label: 'Capacidad' %}
          {%- endif -%}
          {%- if price_filter -%}
            {% render 'collection-grid2-filter', filter: price_filter, label: 'Precio' %}
          {%- endif -%}
          {%- if request.design_mode -%}
            {%- if availability_filter == blank or category_filter == blank or capacity_filter == blank or price_filter == blank -%}
              <p class="cg2-filter-note">Revisá que Disponibilidad, Categoría, Capacidad y Precio estén configurados en Shopify Search &amp; Discovery y disponibles para esta colección.</p>
            {%- endif -%}
          {%- endif -%}
          {%- if has_filters -%}<button class="button button--primary cg2-apply" type="submit">Aplicar filtros</button>{%- endif -%}
        </form>
      </aside>
      <div class="cg2-main">
        <div class="cg2-toolbar">
          <h2 class="cg2-title">{{ collection.title | escape }} <span class="cg2-count">({{ collection.products_count }} productos)</span></h2>
          <div class="cg2-sort">
            <label for="Grid2Sort-{{ section.id }}">{{ 'products.facets.sort_by_label' | t }}</label>
            <select id="Grid2Sort-{{ section.id }}" name="sort_by" form="{{ form_id }}">
              {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
            </select>
            <button type="submit" class="button button--secondary" form="{{ form_id }}">Ordenar</button>
          </div>
        </div>
        <ul class="cg2-active" role="list">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}<li><a href="{{ value.url_to_remove }}">{{ filter.label | escape }}: {{ value.label | escape }} <span aria-hidden="true">×</span><span class="visually-hidden">Quitar filtro</span></a></li>{%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}<li><a href="{{ filter.url_to_remove }}">{{ filter.label | escape }} <span aria-hidden="true">×</span><span class="visually-hidden">Quitar filtro de precio</span></a></li>{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if collection.products.size > 0 -%}
          <ul class="cg2-grid" role="list">
            {%- for product in collection.products -%}
              {%- assign eager = false -%}{%- if forloop.index <= 2 -%}{%- assign eager = true -%}{%- endif -%}
              <li>{% render 'collection-grid2-card', product: product, section: section, eager: eager %}</li>
            {%- endfor -%}
          </ul>
          {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate, anchor: '' %}{%- endif -%}
        {%- else -%}
          <div class="cg2-empty"><h3>No encontramos productos con estos filtros.</h3><a class="button button--secondary" href="{{ collection.url }}?sort_by={{ sort_by | url_encode }}">Limpiar filtros</a></div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% render 'collection-grid2-quantity', section_id: section.id %}
</collection-grid-quote>
{% schema %}
{
  "name": "Grilla de productos 2",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {"type": "header", "content": "Iconos de botones"},
    {"type": "image_picker", "id": "section_button_icon_image", "label": "Imagen para los botones", "info": "Opcional. Sin imagen se usa la configuración global del tema. Se recomienda PNG transparente."},
{"type": "select", "id": "section_button_icon_image_position", "label": "Posición del icono", "default": "inherit", "options": [{"value": "inherit", "label": "Heredar configuración"}, {"value": "left", "label": "Izquierda del texto"}, {"value": "right", "label": "Derecha del texto"}]},
{"type": "color", "id": "section_button_icon_image_text_color", "label": "Color del texto del botón", "info": "Opcional. Vacío conserva el esquema de colores o la configuración heredada."},
    {"type": "range", "id": "section_button_icon_size", "label": "Tamaño de iconos", "info": "Se aplica a las imágenes elegidas en esta sección o sus bloques.", "min": 12, "max": 40, "step": 1, "default": 18, "unit": "px"},
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de colores",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Productos por página",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en móvil",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Formato de las imágenes",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Cuadrado"
        },
        {
          "value": "0.8",
          "label": "Vertical"
        }
      ]
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Fondo de las imágenes",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de selección y foco",
      "default": "#FF8000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título de colección",
      "min": 18,
      "max": 48,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Tamaño de nombres de productos",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Espacio superior e inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar también el precio de venta del producto",
      "default": false
    },
    {
      "type": "header",
      "content": "Metacampos y filtros"
    },
    {
      "type": "paragraph",
      "content": "La columna usa los filtros Disponibilidad, Categoría, Capacidad y Precio de Shopify Search & Discovery. Para los metacampos, ingresá namespace.clave."
    },
    {
      "type": "text",
      "id": "category_metafield",
      "label": "Categoría (metacampo alternativo)",
      "default": "custom.categoria"
    },
    {
      "type": "text",
      "id": "capacity_metafield",
      "label": "Capacidad (filtro y tarjeta)",
      "default": "custom.capacidad"
    },
    {
      "type": "text",
      "id": "material_metafield",
      "label": "Material (ajuste anterior)",
      "default": "custom.material"
    },
    {
      "type": "text",
      "id": "colors_metafield",
      "label": "Colores disponibles (ajuste anterior)",
      "default": "custom.colores_disponibles"
    },
    {
      "type": "text",
      "id": "box_metafield",
      "label": "Unidades por caja (tarjeta)",
      "default": "custom.unidades_por_caja"
    },
    {
      "type": "text",
      "id": "usd_metafield",
      "label": "Precio USD (tarjeta)",
      "default": "custom.precio_usd"
    }
  ],
  "presets": [
    {
      "name": "Grilla de productos 2"
    }
  ]
}
{% endschema %}
