{{ 'section-personalization-block.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign desktop_image = section.settings.image | default: section.settings.image_mobile
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
-%}
{%- style -%}
  {%- if section.settings.custom_font -%}
    {{ section.settings.font | font_face: font_display: 'swap' }}
  {%- endif -%}
  #Personalization-{{ section.id }} {
    --ps-background: {{ section.settings.background }};
    --ps-text: {{ section.settings.text_color }};
    --ps-heading: {{ section.settings.heading_color }};
    --ps-accent: {{ section.settings.accent_color }};
    --ps-overlay: {{ section.settings.overlay_color }};
    --ps-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ps-overlay-opacity-mobile: {{ section.settings.overlay_opacity_mobile | divided_by: 100.0 }};
    --ps-width: {{ section.settings.content_width }}px;
    --ps-copy-width: {{ section.settings.copy_width }}%;
    --ps-icon: {{ section.settings.icon_size }}px;
    --ps-padding: {{ section.settings.padding_desktop }}px;
    --ps-padding-mobile: {{ section.settings.padding_mobile }}px;
    --ps-height: {{ section.settings.min_height }}px;
    --ps-height-mobile: {{ section.settings.min_height_mobile }}px;
    --ps-block-gap: {{ section.settings.block_gap }}px;
    --ps-desktop-position: {{ desktop_image.presentation.focal_point | default: '50% 50%' }};
    --ps-mobile-position: {{ mobile_image.presentation.focal_point | default: '50% 50%' }};
    {%- if section.settings.custom_font %}
      --ps-font: {{ section.settings.font.family }}, {{ section.settings.font.fallback_families }};
      --ps-font-style: {{ section.settings.font.style }};
      --ps-font-weight: {{ section.settings.font.weight }};
    {%- endif %}
  }
  {%- for block in section.blocks -%}
    #Personalization-{{ section.id }} #PersonalizationText-{{ block.id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
      {%- if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
    }
    @media screen and (min-width: 750px) {
      #Personalization-{{ section.id }} #PersonalizationText-{{ block.id }} {
        font-size: {{ block.settings.font_size_desktop }}px;
      }
    }
    {%- for index in (1..3) -%}
      {%- assign color_key = 'highlight_color_' | append: index -%}
      #Personalization-{{ section.id }} #PersonalizationText-{{ block.id }} .personalization-highlight--{{ index }} {
        color: {{ block.settings[color_key] | default: section.settings.accent_color }};
      }
    {%- endfor -%}
  {%- endfor -%}
{%- endstyle -%}

<div id="Personalization-{{ section.id }}" class="personalization-block color-{{ section.settings.color_scheme }}">
  {%- if desktop_image != blank -%}
    <picture class="personalization-block__media" aria-hidden="true">
      <source media="(max-width: 749px)" sizes="100vw" srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w, {{ mobile_image | image_url: width: 1500 }} 1500w">
      {{ desktop_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: image_loading, fetchpriority: image_priority, alt: '' }}
    </picture>
  {%- endif -%}
  <div class="personalization-block__overlay"></div>
  <div class="personalization-block__layout">
    <div class="personalization-block__copy">
      {%- for block in section.blocks -%}
        {%- liquid
          assign text = block.settings.text
          if block.type == 'heading'
            assign text = block.settings.heading
          endif
        -%}
        {%- capture formatted_text -%}{% render 'personalization-richtext', text: text %}{%- endcapture -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p id="PersonalizationText-{{ block.id }}" class="personalization-block__eyebrow caption-with-letter-spacing" {{ block.shopify_attributes }}>{{ formatted_text }}</p>
          {%- when 'heading' -%}
            <h2 id="PersonalizationText-{{ block.id }}" class="personalization-block__heading inline-richtext" {{ block.shopify_attributes }}>{{ formatted_text }}</h2>
          {%- when 'text' -%}
            <div id="PersonalizationText-{{ block.id }}" class="personalization-block__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>{{ formatted_text }}</div>
          {%- when 'benefit' -%}
            <div class="personalization-block__benefit" {{ block.shopify_attributes }}>
              <span class="personalization-block__icon{% if block.settings.image != blank and block.settings.tint_icon %} personalization-block__icon--tinted{% endif %}" aria-hidden="true"
                {% if block.settings.image != blank and block.settings.tint_icon %}style="--ps-mask: url('{{ block.settings.image | image_url: width: 240 | escape }}');"{% endif %}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 240 | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', alt: '' }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                {%- endif -%}
              </span>
              <div id="PersonalizationText-{{ block.id }}" class="personalization-block__benefit-text">{{ formatted_text }}</div>
            </div>
          {%- when 'button' -%}
            <div class="personalization-block__button-wrapper" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label != blank -%}
                <a id="PersonalizationText-{{ block.id }}" class="personalization-block__button button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                  <span>{{ block.settings.button_label | escape }}</span>
                  {%- if block.settings.show_arrow -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>{%- endif -%}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>
