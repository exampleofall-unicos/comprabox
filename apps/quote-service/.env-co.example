PORT=3000
SHOPIFY_SHOP=comprabox-2.myshopify.com
SHOPIFY_API_SECRET=replace-with-app-secret
SHOPIFY_CLIENT_ID=replace-with-client-id
# Alternative: an already provisioned offline access token (server only).
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_PUBLICATION_ID=gid://shopify/Publication/REPLACE
SHOPIFY_API_VERSION=2026-10
QUOTE_ENABLED=true
DATABASE_PATH=./data/quotes-co.sqlite
# 32 random bytes encoded as 64 hex characters. Back this key up securely.
DATA_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=your-store-domain.com
# Optional Resend transactional email. Sending stays pending until configured.
RESEND_API_KEY=
EMAIL_FROM=Comprabox <cotizaciones@your-domain.com>
NOTIFY_EMAIL=ventas@your-domain.com
