{%- render 'section-button-icons', section: section -%}
{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>

{% render 'quick-order-list', product: product, show_image: true, show_sku: true, is_modal: true %}

{% schema %}
{
  "settings": [
  {
    "type": "header",
    "content": "Iconos de botones"
  },
  {
    "type": "image_picker",
    "id": "section_button_icon_image",
    "label": "Imagen para los botones",
    "info": "Opcional. Sin imagen se hereda el icono de la sección o del tema. Se recomienda PNG transparente."
  },
  {
    "type": "range",
    "id": "section_button_icon_size",
    "label": "Tamaño de iconos",
    "min": 12,
    "max": 40,
    "step": 1,
    "default": 18,
    "unit": "px"
  }
],
  "name": "t:sections.quick-order-list.name",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
